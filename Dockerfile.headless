FROM python:3.10-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

# Install dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy shared source code directory (required for onion_crypto, constants, etc.)
COPY src/ ./src/

# Copy network domain source code
COPY directory_api.py .
COPY relay_node.py .

# Entrypoint script will run either the directory or relay based on the ROLE env var
CMD if [ "$ROLE" = "directory" ]; then python directory_api.py; else python relay_node.py; fi
